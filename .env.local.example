# ─── Mission Control · variables de entorno ──────────────────────────────────

# Auth (Supabase, cliente + middleware). Públicas (protegidas por RLS/allowlist).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# URL pública del sitio (redirect del magic link). En Vercel: la URL del deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allowlist del equipo (coma-separado). FAIL-CLOSED: vacío = NADIE entra.
PANEL_ALLOWED_EMAILS=elisa.qualy@gmail.com,otro@equipo.com

# Fuente de datos del panel (server-only). Mismo proyecto Supabase que arriba.
#   DASHBOARD_DATA=real  → Supabase (+ grafo/gateways internos si están)
#   DASHBOARD_DATA=mock  → fixtures (útil en dev)
#   sin definir          → real si hay SERVICE_ROLE_KEY, mock si no
DASHBOARD_DATA=real
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>   # SERVER-ONLY. Bypassa RLS. Nunca al cliente.

# Servicios internos (Docker/Hetzner). En Vercel NO son alcanzables → esas
# piezas (grafo/health de gateways) degradan a null/"caído" sin romper el panel.
# GRAFO_URL=http://grafo:3000
# GATEWAY_NEGOCIO_URL=http://hermes-negocio:8642

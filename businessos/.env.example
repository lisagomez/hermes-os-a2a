# Hermes OS · A2A — variables de entorno
# Copia este archivo como .env (sin extension) junto a docker-compose.yml:
#     cp .env.example .env     # renombralo a .env.example si lo subes asi al server
# NUNCA subas el .env a GitHub. Confirma que .env esta en tu .gitignore.

# ---- Proveedor de modelo (uno u otro) ----
# OpenRouter: una sola llave da acceso a 300+ modelos. Enruta por tarea:
# Haiku para lo ligero, Sonnet para lo importante.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Si usas Nous Portal en vez de OpenRouter, el wizard maneja el OAuth y no
# necesitas pegar llave aqui (deja la de arriba vacia).

# ---- Bots de Telegram (uno por vertical) ----
# Crea tres con @BotFather (/newbot tres veces). Telegram solo permite UNA
# conexion por token, por eso cada contenedor necesita el suyo.
TELEGRAM_BOT_TOKEN_PERSONAL=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN_NEGOCIO=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN_CLIENTES=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Supabase (fuente de verdad de cifras) ----
# Las tres verticales registran token_usage y leen KPIs/gasto desde aqui
# (ver AGENTS.md). Saca estos valores en tu proyecto Supabase:
#   Project Settings → API → Project URL  y  service_role secret.
# El service_role BYPASSEA RLS: es una llave de SERVIDOR. Solo vive en este .env
# del servidor, NUNCA en codigo cliente ni en el repo.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Grafo (cerebro regulatorio fiscal, Fase 2) ----
# Password del postgres interno del grafo (solo viaja dentro de hermes-net).
# Generala aleatoria:  openssl rand -hex 24
GRAFO_DB_PASSWORD=cambia-esta-contrasena-aleatoria

# ---- Grafo-A2A (el grafo como agente A2A, Fase 5) ----
# URL que el Agent Card anuncia a otros agentes. Dentro de hermes-net el
# default (http://grafo-a2a:4000) es correcto y NO necesitas definirla.
# Solo cambiala si algun dia publicas el agente detras de un dominio con auth
# (residual futuro): la card nunca debe anunciar una URL que no funcione.
# GRAFO_A2A_PUBLIC_URL=http://grafo-a2a:4000

# ---- Polar (cobro, Fase 3) ----
# Polar es Merchant of Record: cobra tarjetas/fiat y asume IVA/GST internacional.
# Payouts a Mexico soportados via Stripe Connect Express (verificado 2026-07-02).
# 1) Crea la organizacion en polar.sh y un Organization Access Token (scope
#    checkouts:write + checkout_links:write).
# 2) Crea UNA vez un producto de precio custom/pay-what-you-want (p. ej. "Cobro de
#    servicios") y pega su UUID abajo: polar-cobros.py lo usa como default.
# Costo Starter: 5% + 50c por transaccion. Sandbox: POLAR_API=https://sandbox-api.polar.sh/v1
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxxxxxx
POLAR_PRODUCT_ID=00000000-0000-0000-0000-000000000000

# ---- Dashboards (ambos SOLO en 127.0.0.1, acceso por tunel SSH) ----
# a2abot = Mission Control (Fase 4): Pantheon + AI Spend + Grafo, solo lectura.
#   Usa SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY de arriba; no necesita vars nuevas.
#     ssh -L 9200:localhost:9200 hermes@LA_IP   →   http://localhost:9200
# hermes-dashboard = vista nativa de UNA vertical (negocio):
#     ssh -L 9119:localhost:9119 hermes@LA_IP   →   http://localhost:9119
# El basic auth de abajo es defensa en profundidad por encima del tunel.
# Genera DASH_PASS y DASH_SECRET aleatorios, p. ej.:  openssl rand -hex 32
DASH_USER=admin
DASH_PASS=cambia-esta-contrasena
DASH_SECRET=una-cadena-larga-y-aleatoria-para-sesiones-estables

# ---- Trio Ejecutor/Supervisor (Fase 6) ----
# Motor del Ejecutor: mock (default, cero tokens) o claude (motor real; requiere
# el CLI de Claude Code en la imagen + ANTHROPIC_API_KEY — decision de la dueña,
# quema tokens; el gasto se registra en token_usage con vertical 'trio').
# EJECUTOR_ENGINE=mock
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
#
# --- Motor del trio en GLM-5.2 (opt-in; deja vacio para usar Anthropic) ---
# GLM-5.2 es ~1/6 del costo de Opus/Sonnet y esta hecho para coding agentico.
# El SDK (Claude Code por debajo) honra estas dos vars; apuntalas al endpoint
# Anthropic-compatible de z.ai. En la TAREA: limites.modelo_pref = "glm-5.2"
# (o "glm-5.2[1m]" para el contexto de 1M). El Supervisor re-corre los gates
# igual → el output de GLM se verifica como el de Claude.
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=<z.ai coding-plan key>
#
# Repo objetivo sobre el que trabaja el Ejecutor (se monta como /repo):
# TRIO_REPO_HOST=/home/hermes/businessos/trio-repo

# =====================================================================
# cliente-web2 — superficie de cara al cliente humano (web2)
# Copiar a .env.local y rellenar. NUNCA commitear secretos.
# =====================================================================

# --- Supabase (cloud, público) ---------------------------------------
# El browser usa la anon key (RLS). Las tablas de negocio (leads, cobros)
# se escriben SOLO desde routes server-side con la service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only — NUNCA exponer al cliente. Bypassa RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Daemon Hermes / A2A (chat en vivo) ------------------------------
# URL del daemon. En dev local: http://localhost:3099.
# En prod (Vercel) debe ser una URL pública autenticada vía el edge Caddy
# (paso de infra; ver README). Si no está expuesto, el chat degrada con aviso.
CLAUDECLAW_URL=http://localhost:3099
# Bearer compartido bidireccional (openssl rand -hex 32). server-only.
OPENCLAW_GATEWAY_TOKEN=

# --- Pagos: Polar (Merchant of Record) -------------------------------
# server-only. Sandbox: POLAR_API=https://sandbox-api.polar.sh/v1
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_API=https://api.polar.sh/v1
# Webhook (api/webhooks/polar): configura el endpoint en el dashboard de
# Polar -> https://<este-dominio>/api/webhooks/polar, evento checkout.updated,
# y pega aqui el secreto que te da Polar al crearlo.
POLAR_WEBHOOK_SECRET=

# --- Grafo (deducibilidad, opcional/teaser) --------------------------
# Interno (127.0.0.1:3000) — requiere exposición para uso desde Vercel.
GRAFO_URL=

# --- Sitio -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

legacy-peer-deps=true

# Esperar 3 dias antes de instalar una version recien publicada (defensa ante paquetes
# comprometidos). Aplica cuando npm RESUELVE versiones (npm install / npm update) con npm 11.10 o
# superior. `npm ci` instala lo que diga el lockfile sin revisar fechas, asi que no cambia CI.
# Parche de seguridad urgente: min-release-age-exclude=<paquete> (npm excluye por nombre, no por
# version), con motivo y fecha; se quita cuando el parche cumpla 3 dias.
min-release-age=3

# ══════════════════════════════════════════════════════════════════════════
# business-os-new — configuración
# Copia este archivo a .env.local y llena tus valores:  cp .env.example .env.local
# Las NEXT_PUBLIC_* se inline-an en el bundle del browser EN BUILD TIME:
# si las cambias, re-buildea (npm run build / desktop:install).
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase (REQUERIDO) ────────────────────────────────────────────────────
# Tu proyecto de Supabase (Dashboard → Settings → API). Es la BD de la app:
# tareas, chat, canvas, calendario, push. Crea el esquema con `npx supabase db push`.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Anon / publishable key (segura para el cliente; RLS la limita)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SOLO server (API routes). NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Identidad (REQUERIDO el owner) ──────────────────────────────────────────
# El login está gated por allowlist: solo estos emails pueden entrar.
OWNER_EMAIL=tu-email@ejemplo.com
# Admins adicionales (CSV, opcional):  ADMIN_EMAILS=a@x.com,b@y.com
ADMIN_EMAILS=
# Miembros adicionales (CSV, opcional, rol member):
ALLOWED_EMAILS=
# Tu nombre y email para la superficie desktop (que no tiene sesión de browser)
NEXT_PUBLIC_OWNER_NAME=Owner
NEXT_PUBLIC_OWNER_EMAIL=tu-email@ejemplo.com
# UUID de tu profile (tabla profiles) — lo usan las escrituras del agente
# (canvas, local-first sync) para atribuirte la autoría. Opcional: sin él se
# usa el usuario de la sesión.
OWNER_PROFILE_ID=

# ── Tu agente ───────────────────────────────────────────────────────────────
# Nombre de TU agente: header del chat, título de los push, wake word del HUD.
NEXT_PUBLIC_AGENT_NAME=Agent

# Artificial Brain · Neuronas: path a TU carpeta de markdown curado
# (contiene .claude/memory y/o .claude/knowledge). Vacio por default.
MEMORY_ROOT=
# URL del daemon del agente (el "cerebro" que responde el chat). README →
# "Integración: el AGENTE/daemon" documenta el contrato HTTP completo.
CLAUDECLAW_URL=http://localhost:3099
# Token compartido app ↔ daemon (ambas direcciones). Genera uno:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
# UUID (tabla agents) opcional para atribuir la actividad de calendario al agente
AGENT_PROFILE_ID=

# ── Deploy ──────────────────────────────────────────────────────────────────
# URL canónica del deploy (links de reset de password y share). En local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Web Push (opcional) ─────────────────────────────────────────────────────
# Notificaciones al teléfono/desktop aunque la app esté cerrada.
# Genera el par:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: de contacto que exige el protocolo VAPID
VAPID_EMAIL=admin@example.com
# Pon 'true' para silenciar el push post-turno del chat
DISABLE_CHAT_PUSH=

# ── Voz (opcional) ──────────────────────────────────────────────────────────
# STT (voz → texto) del chat y el HUD Live — Groq Whisper
GROQ_API_KEY=
# TTS de baja latencia del HUD Live (fallback: el TTS del daemon en /tts)
ELEVENLABS_API_KEY=
# Voice id de ElevenLabs para la voz del agente
COMMAND_TTS_VOICE=
COMMAND_TTS_MODEL=eleven_flash_v2_5
# Auto-título de conversaciones (gateway LLM, opcional)
NEXOS_API_KEY=

# ── Zonas horarias (opcional) ───────────────────────────────────────────────
# Zona horaria para el "hoy" de finanzas (movimientos y cierres, docs/FINANCES.md)
FINANCE_TZ=America/Mexico_City
# Zona horaria del daemon: fallback de la sala Acciones (server) y proyección
# de crons en el calendario (cliente — NEXT_PUBLIC_*, se inline-a en build)
DAEMON_TZ=America/Mexico_City
NEXT_PUBLIC_DAEMON_TZ=America/Mexico_City

# ── Calendario / Google (opcional) ──────────────────────────────────────────
# Requiere el CLI `gog` autenticado en esta máquina (README → "Integración:
# CALENDARIO"). Cuenta principal de Google Calendar:
GOOGLE_CALENDAR_ACCOUNT=
# Cuenta secundaria opcional (ej. la de tu empresa)
GOOGLE_CALENDAR_ACCOUNT_SECONDARY=
# Password del keyring local de gog (requerido para ESCRIBIR eventos)
GOG_KEYRING_PASSWORD=
# Calendario opcional de "objetivo del día" (id tipo xxx@group.calendar.google.com)
OBJECTIVE_CALENDAR_ID=

# ── Todoist (opcional — integrations/todoist/sync.py) ───────────────────────
# El sync corre FUERA de la app (launchd/cron) y lee estas vars de su entorno:
#   TODOIST_API_TOKEN, TODOIST_SYNC_LABEL (default business-os),
#   TODOIST_PROJECT_NAME (default "Business OS") + las 3 de Supabase de arriba.

# ── Desktop (Tauri) — las setea el launcher, no las toques normalmente ──────
# BUSINESS_OS_DESKTOP_EMBED=1   (bypass de auth SOLO en localhost)
# BUSINESS_OS_DESKTOP_PORT=3218
# BUSINESS_OS_CANVAS_CACHE_DIR= (cache local del canvas)

    "@tauri-apps/cli": "^2.11.2",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",

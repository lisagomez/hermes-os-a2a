{
  "name": "business-os-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "BUSINESS_OS_DESKTOP_PORT=3000 tauri dev",
    "desktop:build": "tauri build --debug --no-bundle",
    "desktop:app": "tauri build --bundles app --no-sign",
    "desktop:install": "node scripts/desktop-install.mjs",
    "desktop:open": "open \"$HOME/Applications/business-os-new.app\"",
    "desktop:restart": "node scripts/desktop-restart.mjs",
    "desktop:rebuild-restart": "node scripts/desktop-restart.mjs --build",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:logs": "tail -f /tmp/business-os-desktop.log",
    "desktop:bundle": "tauri build",
    "desktop:info": "tauri info"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",

# Meeting Copilot — variables de entorno (copia a .env.local para dev)
# La auth es FAIL-CLOSED: sin configurar Supabase y sin AUTH_DISABLED, nadie entra.

# --- Dev local mock-first (el modo del README): salta la auth SIN Supabase.
# JAMÁS fijar en producción.
AUTH_DISABLED=1

# --- Auth real (patrón Mission Control: magic link + allowlist) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# NEXT_PUBLIC_SITE_URL=https://meeting-copilot-pi.vercel.app   # redirect del magic link
# PANEL_ALLOWED_EMAILS=a@x.com,b@y.com   # coma-separado; vacío = nadie entra

# --- Motor LLM (opcional en dev; sin ella degrada visible a reglas) ---
# OPENROUTER_API_KEY=
# NEXT_PUBLIC_AGENT_ENGINE=llm

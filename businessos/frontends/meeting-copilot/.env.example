# Meeting Copilot — variables de entorno (copia a .env.local para dev)
# La auth es FAIL-CLOSED: sin configurar Supabase y sin AUTH_DISABLED, nadie entra.

# --- Dev local mock-first (el modo del README): salta la auth SIN Supabase.
# JAMÁS fijar en producción.
AUTH_DISABLED=1

# --- Auth real (patrón Mission Control: magic link + allowlist) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# NEXT_PUBLIC_SITE_URL=https://meeting-copilot-pi.vercel.app   # redirect del magic link
# PANEL_ALLOWED_EMAILS=a@x.com,b@y.com   # coma-separado; vacío = nadie entra

# --- Workspace CRM (/crm): datos REALES server-side (sin modo mock) ---
# Sin la key, /crm muestra "Supabase no configurado" (estado honesto).
# La URL sale de NEXT_PUBLIC_SUPABASE_URL (o SUPABASE_URL si se prefiere).
# SUPABASE_SERVICE_ROLE_KEY=<service_role key — jamás en el cliente ni en git>

# --- Motor LLM (opcional en dev; sin ella degrada visible a reglas) ---
# OPENROUTER_API_KEY=
# NEXT_PUBLIC_AGENT_ENGINE=llm

# --- Agendamiento (SPEC §19) ---
# Notificador de la cola de confirmaciones (email + WhatsApp): 'mock' simula el
# host-job en el navegador; 'host-job' es el contrato real (reservado post-MVP).
# NEXT_PUBLIC_AGENDA_NOTIFICADOR=mock

# --- Grafo regulatorio (Pre-Discovery, bloque "Marco regulatorio") ---
# Puente publico grafo-gate; sin GRAFO_URL el bloque cae al mock fiel del grafo.
# GRAFO_URL=https://grafo.167-233-233-56.sslip.io
# GRAFO_TOKEN=<token del grafo-gate; server-only, jamas al navegador>

# --- Waterfall de enriquecimiento (Pre-Discovery, bloque "Enriquecimiento") ---
# Puente publico enriquecimiento-gate. Sin ENRIQUECIMIENTO_URL el bloque se
# DECLARA no disponible: no hay modo demo, porque inventar el correo de una
# empresa real es justo el fallo que ese servicio existe para evitar.
# Requiere ademas SUPABASE_SERVICE_ROLE_KEY (el servicio exige el lead en
# public.leads; la ruta lo da de alta con origen 'copilot' sin pisar su etapa).
# ENRIQUECIMIENTO_URL=https://enriquecimiento.167-233-233-56.sslip.io
# ENRIQUECIMIENTO_TOKEN=<token del enriquecimiento-gate; server-only>

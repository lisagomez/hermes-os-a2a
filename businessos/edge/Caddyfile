# Edge publico de BusinessOS. Publica CUATRO cosas y nada mas:
#   - /chat/stream  -> chat-web2:4500    (chat de venta de la landing, Fase 11)
#   - /crm/*        -> crm-canales:4600  (webhooks Telegram/WhatsApp del CRM, CRM-0)
#   - todo lo demas -> ventas-a2a:4400   (card comercial A2A, Fase 9)
#   - grafo.<host>  -> grafo-gate:5200   (puente Vercel→grafo, token Bearer; 2026-08-07)
# Dominio temporal sslip.io (decision de la dueña 2026-07-10, "probar primero");
# al comprar dominio real: cambiar el site address + VENTAS_PUBLIC_URL y ya.
{
	email lisagomez967@gmail.com
	order rate_limit before reverse_proxy
}

167-233-233-56.sslip.io {
	# --- Chat de la landing web2 (SSE) -> daemon chat-web2 ---
	# handle exclusivo por path: solo /chat/stream entra aqui; el resto cae al
	# handle catch-all de abajo. Rate-limit propio (mas estricto: un chat legitimo
	# no manda 20 turnos/min) y flush_interval -1 para NO bufferear el stream SSE.
	handle /chat/stream {
		rate_limit {
			zone web2chat {
				key {remote_host}
				events 20
				window 1m
			}
		}
		# Un turno de chat son unos KB; el daemon ademas valida y acota.
		request_body {
			max_size 32KB
		}
		reverse_proxy chat-web2:4500 {
			flush_interval -1
		}
	}

	# --- Webhooks del CRM marca blanca (Telegram/WhatsApp) -> crm-canales ---
	# Telegram valida por secret-token de header; WhatsApp por verify_token.
	handle /crm/* {
		rate_limit {
			zone crm {
				key {remote_host}
				events 60
				window 1m
			}
		}
		request_body {
			max_size 64KB
		}
		# El servicio expone /webhook/...; /crm es solo el prefijo publico.
		uri strip_prefix /crm
		reverse_proxy crm-canales:4600
	}

	# --- Card comercial A2A (todo lo demas) -> ventas-a2a ---
	handle {
		# 30 req/min por IP: trafico legitimo de una card comercial esta muy por
		# debajo; protege a ventas-a2a (y a Supabase detras) de scrapers/floods.
		rate_limit {
			zone ventas {
				key {remote_host}
				events 30
				window 1m
			}
		}
		# Un lead A2A son unos KB de JSON-RPC; nadie legitimo manda mas.
		request_body {
			max_size 64KB
		}
		reverse_proxy ventas-a2a:4400
	}
}

# --- Puente del grafo regulatorio (meeting-copilot en Vercel) ---
# El gate valida el token Bearer (fail-closed) y solo proxya POST /evaluaciones;
# aqui solo se publica ese path + el health del gate. Todo lo demas: 404.
grafo.167-233-233-56.sslip.io {
	handle /evaluaciones {
		rate_limit {
			zone grafogate {
				key {remote_host}
				events 30
				window 1m
			}
		}
		# Espejo del MAX_BODY del gate: una evaluacion son unos KB de JSON.
		request_body {
			max_size 64KB
		}
		reverse_proxy grafo-gate:5200
	}
	handle /health {
		reverse_proxy grafo-gate:5200
	}
	handle {
		respond "" 404
	}
}

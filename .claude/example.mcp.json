{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.80"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.8.0"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@0.4.0"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@0.11.0",
        "--project-ref=YOUR_SUPABASE_PROJECT_REF"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_ACCESS_TOKEN"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY"
      }
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_API_KEY"
      }
    },
    "n8n-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MCP_MODE=stdio",
        "-e",
        "LOG_LEVEL=error",
        "-e",
        "DISABLE_CONSOLE_OUTPUT=true",
        "-e",
        "N8N_API_URL=YOUR_N8N_API_URL",
        "-e",
        "N8N_API_KEY=YOUR_N8N_API_KEY",
        "ghcr.io/czlonkowski/n8n-mcp:2.4.2"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "_comment_google": "--- GOOGLE MCPs (Opcionales) --- Descomentar/agregar solo si el proyecto los necesita",
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@15.29.0",
        "mcp"
      ]
    },
    "_comment_google_workspace_retirado": "RETIRADO 2026-09-04: \"@anthropic-ai/google-workspace-mcp\" devuelve 404 en npm — el paquete no existe. Estaba aqui con un alias flotante, asi que nunca fue instalable y nadie lo noto. Si se necesita Workspace, anadir el servidor REAL y PINEADO (C1), no un alias."
  }
}

{
  "name": "Hermes OS · A2A",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000, 4000, 4100, 4200, 4400],
  "portsAttributes": {
    "3000": { "label": "dashboard / next", "onAutoForward": "notify" },
    "4000": { "label": "grafo-a2a" },
    "4100": { "label": "ejecutor-a2a" },
    "4200": { "label": "supervisor-a2a" },
    "4400": { "label": "ventas-a2a" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "tamasfe.even-better-toml",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "python.defaultInterpreterPath": "businessos/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  },
  "remoteUser": "vscode"
}
